# ─────────────────────────────────────────────
# .aiexclude — Gemini context exclusion rules
# ─────────────────────────────────────────────

# 1. Build outputs and caches (Massive token savers)
build/
**/build/
.gradle/
.idea/
.kotlin/
.vscode/
.circleci/
bin/
**/bin/
.git/
**/__pycache__/
**/*.pyc
**/*.class
**/*.hprof
**/captures/
**/*.log
**/*.bak

# 2. Auto-generated code (Reduces AI noise/confusion)
**/generated/
**/*Generated.java
**/*Generated.kt
**/proto/generated/

# 3. Media and Binaries (Images, design files, executables)
**/*.xcf
**/*.vpp
**/*.vpp.*
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/*.svg
**/*.apk
**/*.aab
**/*.jar
**/*.zip
**/*.tar.gz
**/*.pdf
**/fastlane/metadata/android/*/images/
misc/uml/
misc/images/
misc/sounds/

# 4. Large static analysis files
**/*baseline.xml

# 5. Local configuration and API keys
local.properties
*.env
local.properties.gpg
**/*.base64
chance.code-workspace

# 6. Keystores and signing credentials
**/*.jks
**/*.keystore
keystore.properties

# 7. Firebase / Service account files
google-services.json
google-services-staging.json
**/service_account*.json

# 8. OS and System noise
.DS_Store
Thumbs.db

# 9. Scripts and boilerplates
gradlew
gradlew.bat
