CREATE TABLE Roll (
    epoch INTEGER PRIMARY KEY,
    multiplierIndex INTEGER NOT NULL CHECK (multiplierIndex >= 0),
    explodeIndex INTEGER NOT NULL CHECK (explodeIndex >= 0),
    scoreAdjustment INTEGER NOT NULL DEFAULT 0,
    score INTEGER NOT NULL,
    sideUuid TEXT NOT NULL,
    groupUuid TEXT,
    FOREIGN KEY (sideUuid) REFERENCES Side(uuid) ON DELETE CASCADE,
    FOREIGN KEY (groupUuid) REFERENCES DiceGroup(uuid) ON DELETE SET NULL
);

saveRoll:
INSERT OR REPLACE INTO Roll (
    epoch, multiplierIndex, explodeIndex, scoreAdjustment, score, sideUuid, groupUuid
) VALUES (?, ?, ?, ?, ?, ?, ?);

getRolls:
SELECT * FROM Roll ORDER BY epoch DESC;

deleteRollsForDice:
DELETE FROM Roll WHERE sideUuid IN (SELECT uuid FROM Side WHERE diceUuid = :diceUuid);

removeLatestRoll:
DELETE FROM Roll WHERE epoch = (SELECT MAX(epoch) FROM Roll);

getAllSideUuidsFromRolls:
SELECT DISTINCT sideUuid FROM Roll;

clear:
DELETE FROM Roll;
