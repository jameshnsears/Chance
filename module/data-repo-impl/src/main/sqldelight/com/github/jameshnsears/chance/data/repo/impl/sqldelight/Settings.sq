-- Insert or Update the single settings row
saveSettings:
INSERT OR REPLACE INTO Settings (
    id,
    rollIndexTime,
    rollScore,
    diceTitle,
    sideNumber,
    behaviour,
    sideDescription,
    sideSVG,
    rollSound,
    shuffle,
    haptics,
    rollScoreTTS,
    shakeToRoll,
    resizeZoom,
    groupTitle,
    layout,
    history
) VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Fetch the current settings
getSettings:
SELECT *
FROM Settings
WHERE id = 1;

-- Example of a partial update for a specific setting
updateResizeZoom:
UPDATE Settings
SET resizeZoom = :resizeZoom
WHERE id = 1;
