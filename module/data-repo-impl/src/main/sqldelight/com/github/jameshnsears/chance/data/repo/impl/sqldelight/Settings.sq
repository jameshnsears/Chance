import kotlin.Boolean;

CREATE TABLE Settings (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    rollIndexTime INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (rollIndexTime IN (0, 1)),
    rollScore INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (rollScore IN (0, 1)),
    diceTitle INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (diceTitle IN (0, 1)),
    sideNumber INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (sideNumber IN (0, 1)),
    behaviour INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (behaviour IN (0, 1)),
    sideDescription INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (sideDescription IN (0, 1)),
    sideSVG INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (sideSVG IN (0, 1)),
    rollSound INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (rollSound IN (0, 1)),
    shuffle INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (shuffle IN (0, 1)),
    haptics INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (haptics IN (0, 1)),
    rollScoreTTS INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (rollScoreTTS IN (0, 1)),
    shakeToRoll INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (shakeToRoll IN (0, 1)),
    resizeZoom REAL NOT NULL DEFAULT 1.0 CHECK (resizeZoom > 0),
    groupTitle INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (groupTitle IN (0, 1)),
    layout INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (layout IN (0, 1)),
    history INTEGER AS Boolean NOT NULL DEFAULT 0 CHECK (history IN (0, 1))
);

saveSettings:
INSERT OR REPLACE INTO Settings (
    id, rollIndexTime, rollScore, diceTitle, sideNumber, behaviour,
    sideDescription, sideSVG, rollSound, shuffle, haptics,
    rollScoreTTS, shakeToRoll, resizeZoom, groupTitle, layout, history
) VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getSettings:
SELECT * FROM Settings WHERE id = 1;

updateResizeZoom:
UPDATE Settings SET resizeZoom = :resizeZoom WHERE id = 1;

clearSettings:
DELETE FROM Settings;
